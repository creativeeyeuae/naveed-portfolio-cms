# DATABASE_URL is used only by local Prisma CLI tooling (prisma generate /
# prisma migrate), never read at Workers runtime. The actual runtime
# connection (backend/database/client.ts) uses the discrete DB_* fields
# below instead, specifically so a password with special characters doesn't
# need to be percent-encoded into a URL.
DATABASE_URL=postgresql://naveed:naveed_dev_password@localhost:5432/naveed_portfolio_cms
# Discrete connection fields actually used at Workers runtime. Only
# DB_PASSWORD is secret -- host/port/user/database are plain `[vars]` in
# wrangler.toml (see backend/wrangler.toml's [env.preview.vars]).
DB_HOST=aws-1-us-east-1.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.your-project-ref
DB_NAME=postgres
DB_PASSWORD=your-database-password
SUPABASE_URL=https://your-project.supabase.co
# Public anon/publishable key ONLY. Never put the service-role key here or
# anywhere in this backend -- see middleware/auth.ts for why it isn't needed.
SUPABASE_ANON_KEY=your-anon-public-key
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_PUBLIC_URL=https://media.naveedanjum.com
# Required for the legacy /admin PIN login (backend/routes/admin-auth.ts).
# No default -- if unset, all PIN login attempts are refused (fail-secure).
ADMIN_PIN=change-me-to-a-real-non-guessable-value
