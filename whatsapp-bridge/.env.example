# Copy this file to ".env" on the server and fill in the real value below.
# Never commit the real .env file (it's already in .gitignore).

# The live CMS's own domain -- where this bridge sends/receives WhatsApp traffic.
BRIDGE_TARGET_URL=https://bynaveedanjum.com

# Must match the WHATSAPP_BRIDGE_SECRET already set as a Cloudflare Pages secret.
# This is NOT a WhatsApp password -- it's a private key only this bridge and the CMS share,
# so the CMS knows a message really came from this bridge and not from a stranger.
BRIDGE_SECRET=PASTE_THE_SAME_VALUE_HERE

# How often (ms) this bridge checks the CMS for new outgoing messages to deliver.
POLL_INTERVAL_MS=4000
