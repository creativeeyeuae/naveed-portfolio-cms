# Dependencies
node_modules/
**/node_modules/

# Next.js build output
.next/
out/
**/.next/
**/out/

# Env files with real secrets -- never commit these; .env.example templates are fine
.env
.env.local
.env*.local
**/.env
**/.env.local
**/.env*.local

# Cloudflare Wrangler
.wrangler/

# Migration data exports/backups -- local safety copies, never committed
backups/

# WhatsApp bridge session credentials -- this IS the logged-in WhatsApp session itself
# (equivalent to a password). Never committed, never leaves the server it's generated on.
whatsapp-bridge/auth_info_baileys/
**/auth_info_baileys/

# Logs / OS junk
*.log
.DS_Store
Thumbs.db

# TypeScript incremental build cache -- machine/build-specific, never committed
*.tsbuildinfo

# Editor
.vscode/
.idea/
