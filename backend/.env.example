# Public anon/publishable key ONLY. Never put the service-role key here or
# anywhere in this backend -- see middleware/auth.ts for why it isn't needed.
SUPABASE_ANON_KEY=your-anon-public-key
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
